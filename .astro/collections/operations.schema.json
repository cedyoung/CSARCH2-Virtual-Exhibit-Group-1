{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "mnemonic": {
      "type": "string"
    },
    "opcode": {
      "type": "string",
      "pattern": "^[01]{4}$"
    },
    "symbol": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "arithmetic",
        "logic",
        "shift"
      ]
    },
    "summary": {
      "type": "string"
    },
    "flagsAffected": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Z",
          "C",
          "N",
          "V"
        ]
      }
    },
    "diagram": {
      "type": "string"
    },
    "order": {
      "default": 0,
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "mnemonic",
    "opcode",
    "symbol",
    "category",
    "summary",
    "flagsAffected"
  ]
}
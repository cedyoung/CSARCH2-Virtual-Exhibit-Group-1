---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A virtual exhibit on the Arithmetic Logic Unit — the part of a processor that adds, compares, and decides.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · The ALU Exhibit</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><rect width=%2216%22 height=%2216%22 fill=%22%230b0f0d%22/><text x=%228%22 y=%2212%22 font-size=%2210%22 text-anchor=%22middle%22 fill=%22%23ffb000%22 font-family=%22monospace%22>+</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__row">
        <a href="/" class="site-logo">
          <span class="logo__badge">ALU</span>
          <span class="logo__text">VIRTUAL EXHIBIT</span>
        </a>

        <nav class="site-header__nav">
          <a href="/#anatomy" class="nav-link active">What is an ALU?</a>
          <a href="/#binary-basics" class="nav-link">Binary Basics</a>
          <a href="/#operations" class="nav-link">Operations</a>
          <a href="/#simulator" class="nav-link">Simulator</a>
          <a href="/#adder-comparison" class="nav-link">Adder Circuits</a>
          <a href="/#history" class="nav-link">How It Got Here</a>
          <a href="/#tech-stack" class="nav-link">Tech Stack</a>
        </nav>

      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__row">
        <p class="eyebrow">ALU virtual exhibit · built with Astro, MDX &amp; React</p>
        <p class="eyebrow">Computer Interaction · Interactive Learning</p>
      </div>
    </footer>

  </body>
</html>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import AluSchematic from '../components/AluSchematic.astro';
import OperationCard from '../components/OperationCard.astro';
import ALUSimulator from '../components/ALUSimulator.jsx';
import AdderCircuit from '../components/AdderCircuit.jsx';
import { getCollection } from 'astro:content';

const operations = (await getCollection('operations')).sort((a, b) => a.data.order - b.data.order);

const timeline = [
  {
    year: '1937–44',
    title: 'Relay logic',
    body: 'Electromechanical relays open and close to perform binary addition — slow, audible, and the first machines to compute with switches instead of gears.',
  },
  {
    year: '1945',
    title: 'Vacuum-tube arithmetic',
    body: "ENIAC's accumulators add and subtract using thousands of tubes, trading relay speed limits for heat and constant tube failures.",
  },
  {
    year: '1958–63',
    title: 'Discrete transistors',
    body: 'Transistorized logic shrinks the arithmetic unit onto circuit boards small enough to fit inside a single cabinet.',
  },
  {
    year: '1970',
    title: 'The 74181 IC',
    body: 'A single 24-pin chip packages a full 4-bit ALU — sixteen arithmetic and logic operations selectable by four control lines.',
  },
  {
    year: '1971–today',
    title: 'Embedded in the CPU',
    body: "From the Intel 4004 onward, the ALU stops being a separate unit and becomes a block on the processor's own die.",
  },
];
---

<BaseLayout title="Home">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Virtual exhibit · component 3 of the processor</p>
        <h1>The Arithmetic Logic Unit</h1>
        <p class="hero__lede">
          Every add, compare, and bitwise decision a computer makes passes through one small
          circuit. This exhibit opens up the ALU — the block that turns two binary numbers and an
          opcode into a result and a set of flags — and lets you operate one yourself.
        </p>
      </div>
      <div class="hero__diagram">
        <AluSchematic />
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- ANATOMY -->
  <section id="anatomy" class="section">
    <div class="wrap">
      <p class="eyebrow">01 · Anatomy</p>
      <h2>Two operands, one opcode, one answer</h2>
      <div class="anatomy__grid">
        <article class="anatomy__item">
          <h3>Operands — A &amp; B</h3>
          <p>
            The two binary numbers the ALU acts on. In a real CPU these arrive from registers;
            here, you'll set them yourself with the switches below.
          </p>
        </article>
        <article class="anatomy__item">
          <h3>Opcode</h3>
          <p>
            A short binary instruction from the control unit that tells the ALU which operation
            to run — add, subtract, AND, shift, and so on.
          </p>
        </article>
        <article class="anatomy__item">
          <h3>Result &amp; flags</h3>
          <p>
            The output bus carries the answer. Alongside it, four status flags — Zero, Carry,
            Negative, Overflow — report facts about that answer the rest of the CPU can branch on.
          </p>
        </article>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- OPERATIONS -->
  <section id="operations" class="section">
    <div class="wrap">
      <p class="eyebrow">02 · Operations</p>
      <h2>The instruction set</h2>
      <p>Each card is a datasheet for one operation the ALU can run. Open one for its truth table and gate-level view.</p>
      <div class="operations__grid">
        {
          operations.map((op) => (
            <OperationCard
              id={op.id}
              title={op.data.title}
              mnemonic={op.data.mnemonic}
              opcode={op.data.opcode}
              symbol={op.data.symbol}
              summary={op.data.summary}
              diagram={op.data.diagram}
            />
          ))
        }
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- SIMULATOR -->
  <section id="simulator" class="section">
    <div class="wrap">
      <p class="eyebrow">03 · Try it</p>
      <h2>Operate a 4-bit ALU</h2>
      <p>
        Toggle the switches for A and B, pick an operation, and watch the result and status flags
        update live. This is exactly what the chip is doing — just slowed down to bit speed.
      </p>
      <ALUSimulator client:load />

      <div class="simulator__divider">
        <p class="eyebrow">Inside the ADD/SUB path</p>
        <h3>How that carry actually gets computed</h3>
        <p>
          When the operation above is ADD or SUB, the ALU has to add two 4-bit numbers — and that
          means resolving a carry bit at every position. There's more than one way to wire that
          carry chain; switch circuit styles below and watch how differently they settle.
        </p>
      </div>
      <AdderCircuit client:visible />
    </div>
  </section>
  <hr class="hairline" />

  <!-- ADDER CIRCUITS COMPARED -->
  <section id="adder-comparison" class="section">
    <div class="wrap">
      <p class="eyebrow">04 · Adder Circuits Compared</p>
      <h2>Ripple Carry vs. Carry Lookahead</h2>
      
      <div class="comparison__grid">
        <!-- RCA Card -->
        <div class="comparison__card">
          <div class="card__header">
            <span class="badge badge--rca">RCA</span>
            <h3>Ripple Carry Adder</h3>
          </div>
          <p class="card__desc">Each Full Adder waits for the carry-out from the previous stage before computing its sum bit.</p>
          <div class="card__lists">
            <div class="list__group">
              <h4>Advantages</h4>
              <ul>
                <li class="pos">Simple circuit design</li>
                <li class="pos">Fewer logic gates</li>
                <li class="pos">Easy to implement</li>
              </ul>
            </div>
            <div class="list__group">
              <h4>Trade-offs</h4>
              <ul>
                <li class="neg">Slow — each carry must ripple forward</li>
                <li class="neg">Delay grows linearly with bit width</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- CLA Card -->
        <div class="comparison__card">
          <div class="card__header">
            <span class="badge badge--cla">CLA</span>
            <h3>Carry Lookahead Adder</h3>
          </div>
          <p class="card__desc">Uses Generate (G) and Propagate (P) signals to calculate all carry values simultaneously before summing.</p>
          <div class="card__lists">
            <div class="list__group">
              <h4>Advantages</h4>
              <ul>
                <li class="pos">Fast — all carries computed at once</li>
                <li class="pos">Constant delay (independent of width)</li>
                <li class="pos">Used in real CPUs</li>
              </ul>
            </div>
            <div class="list__group">
              <h4>Trade-offs</h4>
              <ul>
                <li class="neg">More complex circuitry</li>
                <li class="neg">Higher gate count</li>
                <li class="neg">More wiring overhead</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- SUBTRACTION PANEL -->
      <div class="subtraction__panel">
        <h3>How Subtraction Works: Two's Complement</h3>
        <p>Instead of building a separate subtraction circuit, the ALU reuses the adder. To compute A − B, it calculates A + (−B). In binary, the negative of a number is its <strong>two's complement</strong>: flip all bits (~B), then add 1.</p>
        
        <div class="steps__grid mono-value">
          <div class="step__item">
            <span class="step__label">Step 1: Original B</span>
            <span class="step__val text-blue">B = 0011 (3)</span>
          </div>
          <div class="step__item">
            <span class="step__label">Step 2: Invert all bits</span>
            <span class="step__val text-orange">~B = 1100</span>
          </div>
          <div class="step__item">
            <span class="step__label">Step 3: Add 1 (carry-in = 1)</span>
            <span class="step__val text-green">~B + 1 = 1101 (-3)</span>
          </div>
        </div>

        <p class="subtraction__footer">In the simulator, when SUB is selected, Operand B is automatically inverted and the initial carry-in is set to 1 — exactly replicating this hardware behavior.</p>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- HISTORY -->
  <section id="history" class="section">
    <div class="wrap">
      <p class="eyebrow">05 · How it got here</p>
      <h2>From relays to silicon</h2>
      <ol class="timeline">
        {
          timeline.map((entry) => (
            <li class="timeline__item">
              <span class="timeline__year mono-value">{entry.year}</span>
              <div>
                <h3 class="timeline__title">{entry.title}</h3>
                <p>{entry.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

<hr class="hairline" />

  <!-- TECH STACK -->
  <section id="tech-stack" class="section">
    <div class="wrap tech-stack__grid">
      
      <!-- Left Column -->
      <div class="tech-stack__info">
        <p class="eyebrow">06 · Tech Stack</p>
        <h2>How This Exhibit Is Built</h2>
        <p class="tech-stack__lede">
          The exhibit is built as a static site using Astro 6, with MDX for content authoring and React JSX for the interactive ALU Simulator component. Styling uses CSS with Astro scoped styles, and all assets are served as PNG images from a GitHub repository.
        </p>

        <!-- Nested Plan Box -->
        <div class="stack-plan__box">
          <div class="stack-plan__header">
            <span class="drag-handle">::</span> Tech Stack Plan:
          </div>
          <table class="stack-plan__table">
            <thead>
              <tr>
                <th>Part</th>
                <th>Plan</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Main framework</td><td>Astro 6</td></tr>
              <tr><td>Runtime</td><td class="text-link">Node.js 26</td></tr>
              <tr><td>Content</td><td>MDX</td></tr>
              <tr><td>Interactive component</td><td>React JSX</td></tr>
              <tr><td>Styling</td><td>CSS / Astro scoped styles</td></tr>
              <tr><td>Assets</td><td>PNG</td></tr>
              <tr><td>Repository</td><td>GitHub</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Right Column -->
      <div class="tech-stack__pills">
        <div class="stack-pill">
          <span class="pill__label">Main framework</span>
          <span class="pill__value text-green">Astro 6</span>
        </div>
        <div class="stack-pill">
          <span class="pill__label">Runtime</span>
          <span class="pill__value text-green">Node.js 26</span>
        </div>
        <div class="stack-pill">
          <span class="pill__label">Content</span>
          <span class="pill__value text-green">MDX</span>
        </div>
        <div class="stack-pill">
          <span class="pill__label">Interactive component</span>
          <span class="pill__value text-green">React JSX</span>
        </div>
        <div class="stack-pill">
          <span class="pill__label">Styling</span>
          <span class="pill__value text-green">CSS / Astro scoped styles</span>
        </div>
        <div class="stack-pill">
          <span class="pill__label">Assets</span>
          <span class="pill__value text-green">PNG</span>
        </div>
        <div class="stack-pill">
          <span class="pill__label">Repository</span>
          <span class="pill__value text-green">GitHub</span>
        </div>
      </div>

    </div>
  </section>


  <style>
    .hero {
      padding-block: clamp(3rem, 8vw, 6rem) 3rem;
    }
    .hero__grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }
    .hero h1 {
      font-size: clamp(2.2rem, 5vw, 3.4rem);
    }
    .hero__lede {
      color: var(--paper-dim);
      font-size: 1.05rem;
    }
    .hero__diagram {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--panel);
      padding: 1.5rem;
    }
    @media (max-width: 860px) {
      .hero__grid {
        grid-template-columns: 1fr;
      }
    }

    .section {
      padding-block: clamp(3rem, 6vw, 5rem);
    }
    .section h2 {
      font-size: clamp(1.5rem, 3vw, 2rem);
      max-width: 40ch;
    }

    .simulator__divider {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
    }
    .simulator__divider h3 {
      font-size: 1.1rem;
      margin-top: 0.4rem;
    }
    .simulator__divider p {
      color: var(--paper-dim);
      font-size: 0.92rem;
    }

    .anatomy__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      margin-top: 2rem;
    }
    .anatomy__item {
      border-top: 2px solid var(--trace-dim);
      padding-top: 0.9rem;
    }
    .anatomy__item h3 {
      font-size: 1rem;
    }
    .anatomy__item p {
      color: var(--paper-dim);
      font-size: 0.92rem;
    }

    .operations__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1.25rem;
      margin-top: 2rem;
    }

    .timeline {
      list-style: none;
      margin: 2rem 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }
    .timeline__item {
      display: grid;
      grid-template-columns: 7rem 1fr;
      gap: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
    }
    .timeline__item:first-child {
      border-top: none;
      padding-top: 0;
    }
    .timeline__year {
      color: var(--trace);
      font-size: 0.85rem;
    }
    .timeline__title {
      font-size: 1rem;
      margin-bottom: 0.35rem;
    }
    .timeline p {
      color: var(--paper-dim);
      font-size: 0.92rem;
    }
    @media (max-width: 560px) {
      .timeline__item {
        grid-template-columns: 1fr;
        gap: 0.4rem;
      }
    }
    .comparison__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
      margin-top: 2rem;
    }
    .comparison__card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2rem;
    }
    .card__header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }
    .badge {
      font-size: 0.75rem;
      font-weight: bold;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
    }
    .badge--rca { background: rgba(0, 150, 136, 0.2); color: #009688; }
    .badge--cla { background: rgba(255, 111, 0, 0.2); color: #ff6f00; }
    
    .card__desc {
      color: var(--paper-dim);
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
      line-height: 1.5;
    }
    .card__lists {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .list__group h4 {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
    }
    .list__group :global(h4:nth-of-type(1)) { color: #009688; } /* Advantages header color */
    .list__group :global(.trade-offs h4) { color: #ff6f00; } /* Trade-offs header color */
    
    .list__group ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      font-size: 0.9rem;
    }
    .list__group li.pos::before { content: "✓ "; color: #009688; margin-right: 0.25rem; }
    .list__group li.neg::before { content: "– "; color: #ff6f00; margin-right: 0.25rem; }

    /* SUBTRACTION PANEL */
    .subtraction__panel {
      margin-top: 2rem;
      background: rgba(var(--panel-rgb), 0.5); /* slightly distinct panel background */
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2rem;
    }
    .subtraction__panel h3 {
      font-size: 1.2rem;
      margin-bottom: 1rem;
    }
    .subtraction__panel p {
      color: var(--paper-dim);
      font-size: 0.95rem;
      line-height: 1.6;
    }
    .steps__grid {
      background: #07111e; /* matching dark inner shell */
      border-radius: 6px;
      padding: 1.25rem;
      margin-block: 1.5rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }
    .step__item {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .step__label {
      font-size: 0.8rem;
      color: #52667d;
    }
    .step__val {
      font-weight: bold;
      font-size: 0.95rem;
    }
    .text-blue { color: #38bdf8; }
    .text-orange { color: #fb923c; }
    .text-green { color: #4ade80; }
    .subtraction__footer {
      font-style: italic;
    }
    .tech-stack__grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
      align-items: start;
      margin-top: 2rem;
    }
    .tech-stack__info h2 {
      margin-bottom: 1rem;
    }
    .tech-stack__lede {
      color: #708198;
      font-size: 1.05rem;
      line-height: 1.6;
      margin-bottom: 2rem;
    }

    /* LEFT EMBEDDED BOX */
    .stack-plan__box {
      background: #04090f;
      border: 1px solid #101f30;
      border-radius: 8px;
      padding: 1.25rem;
      font-family: monospace;
      font-size: 0.85rem;
    }
    .stack-plan__header {
      color: #8b9bb4;
      margin-bottom: 0.75rem;
      font-weight: bold;
    }
    .drag-handle {
      color: #384a62;
      margin-right: 0.25rem;
    }
    .stack-plan__table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    .stack-plan__table th, 
    .stack-plan__table td {
      border: 1px solid #162a3f;
      padding: 0.5rem 0.75rem;
      color: #8b9bb4;
    }
    .stack-plan__table th {
      color: #ffffff;
      font-weight: 600;
    }
    .stack-plan__table td.text-link {
      color: #00a8ff;
      text-decoration: underline;
    }

    /* RIGHT PILL PIECES */
    .tech-stack__pills {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .stack-pill {
      background: rgba(16, 31, 48, 0.4);
      border: 1px solid #101f30;
      border-radius: 6px;
      padding: 1rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .pill__label {
      color: #8b9bb4;
      font-size: 0.95rem;
    }
    .pill__value {
      font-family: monospace;
      font-weight: 600;
      font-size: 0.95rem;
    }
    .pill__value.text-green {
      color: #00ffcc; /* Vibrant Figma neon accent cyan/green */
    }

    /* RESPONSIVE FALLBACK */
    @media (max-width: 860px) {
      .tech-stack__grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }
  </style>
</BaseLayout>

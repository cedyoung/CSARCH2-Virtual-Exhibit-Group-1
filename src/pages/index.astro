---
import BaseLayout from '../layouts/BaseLayout.astro';
import AluSchematic from '../components/AluSchematic.astro';
import OperationCard from '../components/OperationCard.astro';
import ALUSimulator from '../components/ALUSimulator.jsx';
import AdderCircuit from '../components/AdderCircuit.jsx';
import { getCollection } from 'astro:content';
import '../styles/global.css'

const operations = (await getCollection('operations')).sort((a, b) => a.data.order - b.data.order);

const timeline = [
  {
    year: '1937–44',
    title: 'Relay logic',
    body: 'Electromechanical relays open and close to perform binary addition — slow, audible, and the first machines to compute with switches instead of gears.',
  },
  {
    year: '1945',
    title: 'Vacuum-tube arithmetic',
    body: "ENIAC's accumulators add and subtract using thousands of tubes, trading relay speed limits for heat and constant tube failures.",
  },
  {
    year: '1958–63',
    title: 'Discrete transistors',
    body: 'Transistorized logic shrinks the arithmetic unit onto circuit boards small enough to fit inside a single cabinet.',
  },
  {
    year: '1970',
    title: 'The 74181 IC',
    body: 'A single 24-pin chip packages a full 4-bit ALU — sixteen arithmetic and logic operations selectable by four control lines.',
  },
  {
    year: '1971–today',
    title: 'Embedded in the CPU',
    body: "From the Intel 4004 onward, the ALU stops being a separate unit and becomes a block on the processor's own die.",
  },
];
---

<BaseLayout title="Home">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__content">
      <span class="hero__badge">COMPUTER ARCHITECTURE - INTERACTIVE EXHIBIT</span>
      <h1>Arithmetic Logic Unit</h1>
      <p class="hero__lede">
        The brain of the CPU. Explore how computers perform arithmetic and logic operations using binary — and simulate it yourself.
      </p>
      <a href="#simulator" class="btn btn--primary">Launch Simulator</a>
    </div>
  </section>

  <hr class="hairline" />

  <!-- ANATOMY -->
  <section id="anatomy" class="section">
    <div class="wrap">
      <div class="section__eyebrow">
        <span class="line"></span>
        <span class="text">01 — WHAT IS AN ALU?</span>
        <span class="line"></span>
      </div>
      
      <div class="split-layout">
        <div class="split-layout__text">
          <h2>The Calculator Inside Your CPU</h2>
          <p>
            The Arithmetic Logic Unit (ALU) is a fundamental component of the Central Processing Unit (CPU). It is the circuit responsible for executing every mathematical and logical operation a computer performs.
          </p>
          <p>
            Unlike how humans do arithmetic in their heads, the ALU works entirely with binary numbers — sequences of 0s and 1s. Every number, every instruction, every result is represented as a pattern of bits.
          </p>
          <p>
            The ALU receives two binary inputs (Operand A and Operand B), applies a selected operation, and produces a binary result along with status flags that help the CPU make decisions.
          </p>
        </div>
        
        <div class="info-cards">
          <article class="info-card">
            <span class="dot dot--input"></span>
            <div class="info-card__content">
              <h3>Inputs</h3>
              <p>Two binary operands (A and B)</p>
            </div>
          </article>
          <article class="info-card">
            <span class="dot dot--op"></span>
            <div class="info-card__content">
              <h3>Operation</h3>
              <p>Selected via opcode from the control unit</p>
            </div>
          </article>
          <article class="info-card">
            <span class="dot dot--output"></span>
            <div class="info-card__content">
              <h3>Output</h3>
              <p>Binary result of the operation</p>
            </div>
          </article>
          <article class="info-card">
            <span class="dot dot--flags"></span>
            <div class="info-card__content">
              <h3>Flags</h3>
              <p>Zero, Carry, Overflow, Sign</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <section id="binary-basics" class="section">
    <div class="wrap">
      <div class="section__eyebrow">
        <span class="line"></span>
        <span class="text">02 — BINARY BASICS</span>
        <span class="line"></span>
      </div>
      
      <div class="split-layout">
        <div class="split-layout__text">
          <h2>Computers Think in 0s and 1s</h2>
          <p>
            Every piece of data in a computer — numbers, text, images, instructions — is ultimately stored and processed as binary digits (bits). A bit has only two states: 0 (off) or 1 (on).
          </p>
          <p>
            In a binary number, each bit position represents a power of 2. The rightmost bit is 2⁰ (=1), the next is 2¹ (=2), then 2² (=4), and so on. To find the decimal value, add up the weights of all positions where the bit is 1.
          </p>
          
          <div class="code-box">
            <span class="code-title">0110 in binary:</span>
            <code>0×8 + 1×4 + 1×2 + 0×1<br>= 0 + 4 + 2 + 0 = 6</code>
          </div>
        </div>
        
        <div class="binary-widget">
          <p class="widget-header">BINARY REPRESENTATION — HOVER EACH BIT</p>
          <div class="bits-row">
            <div class="bit-col"><span class="weight">128</span><div class="bit on">1</div></div>
            <div class="bit-col"><span class="weight">64</span><div class="bit off">0</div></div>
            <div class="bit-col"><span class="weight">32</span><div class="bit on">1</div></div>
            <div class="bit-col"><span class="weight">16</span><div class="bit on">1</div></div>
            <div class="bit-col"><span class="weight">8</span><div class="bit off">0</div></div>
            <div class="bit-col"><span class="weight">4</span><div class="bit on">1</div></div>
            <div class="bit-col"><span class="weight">2</span><div class="bit on">1</div></div>
            <div class="bit-col"><span class="weight">1</span><div class="bit off">0</div></div>
          </div>
          <div class="widget-result">
            <span class="equals">= </span><span class="decimal">182</span> <span class="label">in decimal</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- OPERATIONS -->
  <section id="operations" class="section">
    <div class="wrap">
      <div class="section__eyebrow">
        <span class="line"></span>
        <span class="text">03 — ALU OPERATIONS</span>
        <span class="line"></span>
      </div>
      <h2>What the ALU Can Do</h2>
      
      <div class="operations__grid">
        {
          operations.map((op) => (
            <OperationCard
              id={op.id}
              title={op.data.title}
              mnemonic={op.data.mnemonic}
              opcode={op.data.opcode}
              symbol={op.data.symbol}
              summary={op.data.summary}
              diagram={op.data.diagram}
            />
          ))
        }
      </div>

      <div class="simulator-focus-box">
        <p>
          <span class="highlight">This simulator focuses on ADD and SUB</span> — the two foundational arithmetic operations — and lets you explore how two different adder circuit designs process the same binary inputs.
        </p>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <section id="simulator" class="section">
    <div class="wrap">
      <div class="section__eyebrow">
        <span class="line"></span>
        <span class="text">04 — MINI ALU SIMULATOR</span>
        <span class="line"></span>
      </div>
      <h2>4-Bit Binary Calculator</h2>
      <p class="section__desc">
        Toggle the bits in Operand A and Operand B. Select an operation and an adder circuit. Watch the ALU process the carries and produce a binary result.
      </p>
      
      <ALUSimulator client:load />

      <div class="simulator-helpers">
        <article class="helper-card">
          <span class="dot"></span>
          <div class="helper-card__content">
            <h3>Click bits</h3>
            <p>Toggle 0 and 1 in each operand</p>
          </div>
        </article>
        <article class="helper-card">
          <span class="dot"></span>
          <div class="helper-card__content">
            <h3>Switch operations</h3>
            <p>ADD uses direct inputs; SUB inverts B and adds 1 (two's complement)</p>
          </div>
        </article>
        <article class="helper-card">
          <span class="dot"></span>
          <div class="helper-card__content">
            <h3>Compare adders</h3>
            <p>Switch between Ripple Carry and Carry Lookahead to see different carry paths</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <section id="adder-comparison" class="section">
    <div class="wrap">
      <div class="section__eyebrow">
        <span class="line"></span>
        <span class="text">05 — ADDER CIRCUITS COMPARED</span>
        <span class="line"></span>
      </div>
      <h2>Ripple Carry vs. Carry Lookahead</h2>
      
      <div class="comparison__grid">
        <div class="comparison__card">
          <div class="card__header">
            <span class="badge badge--rca">RCA</span>
            <h3>Ripple Carry Adder</h3>
          </div>
          <p class="card__desc">Each Full Adder waits for the carry-out from the previous stage before computing its sum bit.</p>
          <div class="card__lists">
            <div class="list__group">
              <h4>Advantages</h4>
              <ul>
                <li class="pos">Simple circuit design</li>
                <li class="pos">Fewer logic gates</li>
                <li class="pos">Easy to implement</li>
              </ul>
            </div>
            <div class="list__group trade-offs">
              <h4>Trade-offs</h4>
              <ul>
                <li class="neg">Slow — each carry must ripple forward</li>
                <li class="neg">Delay grows linearly with bit width</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="comparison__card">
          <div class="card__header">
            <span class="badge badge--cla">CLA</span>
            <h3>Carry Lookahead Adder</h3>
          </div>
          <p class="card__desc">Uses Generate (G) and Propagate (P) signals to calculate all carry values simultaneously before summing.</p>
          <div class="card__lists">
            <div class="list__group">
              <h4>Advantages</h4>
              <ul>
                <li class="pos">Fast — all carries computed at once</li>
                <li class="pos">Constant delay (independent of width)</li>
                <li class="pos">Used in real CPUs</li>
              </ul>
            </div>
            <div class="list__group trade-offs">
              <h4>Trade-offs</h4>
              <ul>
                <li class="neg">More complex circuitry</li>
                <li class="neg">Higher gate count</li>
                <li class="neg">More wiring overhead</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="subtraction__panel">
        <h3>How Subtraction Works: Two's Complement</h3>
        <p>Instead of building a separate subtraction circuit, the ALU reuses the adder. To compute A − B, it calculates A + (−B). In binary, the negative of a number is its <strong>two's complement</strong>: flip all bits (~B), then add 1.</p>
        
        <div class="steps__grid mono-value">
          <div class="step__item">
            <span class="step__label">Step 1: Original B</span>
            <span class="step__val text-blue">B = 0011 (3)</span>
          </div>
          <div class="step__item">
            <span class="step__label">Step 2: Invert all bits</span>
            <span class="step__val text-orange">~B = 1100</span>
          </div>
          <div class="step__item">
            <span class="step__label">Step 3: Add 1 (carry-in = 1)</span>
            <span class="step__val text-green">~B + 1 = 1101 (-3)</span>
          </div>
        </div>

        <p class="subtraction__footer">In the simulator, when SUB is selected, Operand B is automatically inverted and the initial carry-in is set to 1 — exactly replicating this hardware behavior.</p>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- HISTORY -->
  <section id="history" class="section">
    <div class="wrap">
      <div class="section__eyebrow">
        <span class="line"></span>
        <span class="text">06 — HOW IT GOT HERE</span>
        <span class="line"></span>
      </div>
      
      <h2>From Relays to Silicon</h2>
      
      <div class="timeline__container">
        {
          timeline.map((entry) => (
            <div class="timeline__card">
              <div class="timeline__header">
                <span class="timeline__year mono-value">{entry.year}</span>
                <h3>{entry.title}</h3>
              </div>
              <p class="timeline__body">{entry.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <section id="tech-stack" class="section">
    <div class="wrap">
      <div class="section__eyebrow">
        <span class="line"></span>
        <span class="text">07 — TECH STACK</span>
        <span class="line"></span>
      </div>
      <div class="tech-stack__grid">
        <div class="tech-stack__info">
          <h2>How This Exhibit Is Built</h2>
          <p class="tech-stack__lede">
            The exhibit is built as a static site using Astro 6, with MDX for content authoring and React JSX for the interactive ALU Simulator component. Styling uses CSS with Astro scoped styles, and all assets are served as PNG images from a GitHub repository.
          </p>

          <div class="stack-plan__box">
            <div class="stack-plan__header">
              <span class="drag-handle">::</span> Tech Stack Plan:
            </div>
            <table class="stack-plan__table">
              <thead>
                <tr>
                  <th>Part</th>
                  <th>Plan</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Main framework</td><td>Astro 6</td></tr>
                <tr><td>Runtime</td><td class="text-link">Node.js 26</td></tr>
                <tr><td>Content</td><td>MDX</td></tr>
                <tr><td>Interactive component</td><td>React JSX</td></tr>
                <tr><td>Styling</td><td>CSS / Astro scoped styles</td></tr>
                <tr><td>Assets</td><td>PNG</td></tr>
                <tr><td>Repository</td><td>GitHub</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="tech-stack__pills">
          <div class="stack-pill">
            <span class="pill__label">Main framework</span>
            <span class="pill__value text-green">Astro 6</span>
          </div>
          <div class="stack-pill">
            <span class="pill__label">Runtime</span>
            <span class="pill__value text-green">Node.js 26</span>
          </div>
          <div class="stack-pill">
            <span class="pill__label">Content</span>
            <span class="pill__value text-green">MDX</span>
          </div>
          <div class="stack-pill">
            <span class="pill__label">Interactive component</span>
            <span class="pill__value text-green">React JSX</span>
          </div>
          <div class="stack-pill">
            <span class="pill__label">Styling</span>
            <span class="pill__value text-green">CSS / Astro scoped styles</span>
          </div>
          <div class="stack-pill">
            <span class="pill__label">Assets</span>
            <span class="pill__value text-green">PNG</span>
          </div>
          <div class="stack-pill">
            <span class="pill__label">Repository</span>
            <span class="pill__value text-green">GitHub</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

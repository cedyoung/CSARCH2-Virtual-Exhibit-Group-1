---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const operations = await getCollection('operations');
  return operations.map((op) => ({
    params: { slug: op.id },
    props: { op },
  }));
}

const { op } = Astro.props;
const { data } = op;
const { Content } = await render(op);
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="op wrap">
    <a class="op__back" href="/#operations">← Back to operations</a>

    <header class="op__header">
      <div class="op__badges">
        <span class="op__mnemonic">{data.mnemonic}</span>
        <span class="op__opcode mono-value">{data.opcode}</span>
        <span class="op__category eyebrow">{data.category}</span>
      </div>
      <h1>{data.title} <span class="op__symbol">{data.symbol}</span></h1>
      <p class="op__summary">{data.summary}</p>
      <div class="op__flags">
        <span class="eyebrow">Flags affected</span>
        {data.flagsAffected.map((f) => <span class="op__flag mono-value">{f}</span>)}
      </div>
    </header>

    {
      data.diagram && (
        <div class="op__diagram">
          <Image src={data.diagram} alt={`Gate-level diagram for ${data.title}`} width={640} height={360} />
        </div>
      )
    }

    <div class="op__body">
      <Content />
    </div>
  </article>

  <style>
    .op {
      padding-block: 3rem 5rem;
      max-width: 760px;
    }
    .op__back {
      display: inline-block;
      color: var(--paper-dim);
      text-decoration: none;
      font-family: var(--font-label);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.78rem;
      margin-bottom: 2rem;
    }
    .op__back:hover {
      color: var(--trace);
    }
    .op__badges {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      margin-bottom: 0.75rem;
    }
    .op__mnemonic {
      font-family: var(--font-mono);
      color: var(--trace);
      letter-spacing: 0.08em;
      font-size: 0.85rem;
    }
    .op__opcode,
    .op__category {
      color: var(--paper-dim);
      font-size: 0.8rem;
    }
    .op__symbol {
      color: var(--paper-dim);
      font-weight: 400;
    }
    .op__summary {
      color: var(--paper-dim);
      font-size: 1.05rem;
    }
    .op__flags {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-top: 1rem;
    }
    .op__flag {
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      padding: 0.15rem 0.5rem;
      font-size: 0.78rem;
      color: var(--paper);
    }
    .op__diagram {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      background: var(--panel);
      margin: 2rem 0;
    }
    .op__diagram :global(img) {
      display: block;
      width: 100%;
      height: auto;
    }
    .op__body {
      margin-top: 2rem;
    }
    .op__body :global(h2) {
      font-size: 1.2rem;
      margin-top: 2.5rem;
    }
    .op__body :global(table) {
      border-collapse: collapse;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      margin: 1rem 0;
    }
    .op__body :global(th),
    .op__body :global(td) {
      border: 1px solid var(--border);
      padding: 0.4rem 0.7rem;
      text-align: center;
    }
    .op__body :global(th) {
      color: var(--trace);
      font-weight: 500;
    }
  </style>
</BaseLayout>
